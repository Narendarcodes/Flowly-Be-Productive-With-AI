{
  "name": "@extension/e2e",
  "version": "2.0.0",
  "description": "Flowly end-to-end tests: loads the built extension in Chromium with Playwright",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "clean:node_modules": "pnpx rimraf node_modules",
    "clean:turbo": "pnpx rimraf .turbo",
    "clean": "pnpm clean:turbo && pnpm clean:node_modules"
  },
  "devDependencies": {
    "@extension/tsconfig": "workspace:*",
    "@playwright/test": "^1.56.1"
  }
}
